# ---------------------------------------------------------------
# Copy this file to ".env" for local development.
# On Vercel, add the same variables in Project > Settings >
# Environment Variables. NEVER commit the real .env file.
# ---------------------------------------------------------------

# ===== Required: Google Sheets =====
GOOGLE_SERVICE_ACCOUNT_EMAIL=my-service-account@my-project.iam.gserviceaccount.com
# Paste the private_key value from the service-account JSON.
# Keep the literal \n sequences, and wrap the value in double quotes locally.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id-from-the-url
# Optional: tab name (created automatically if missing). Default: Certificates
GOOGLE_SHEET_NAME=Certificates

# Optional: tabs created automatically when missing
GOOGLE_EVENTS_SHEET_NAME=Events
GOOGLE_SIGNATORIES_SHEET_NAME=Signatories
GOOGLE_PURPOSE_TEMPLATES_SHEET_NAME=PurposeTemplates
GOOGLE_CERTIFICATE_TEMPLATES_SHEET_NAME=CertificateTemplates
GOOGLE_ACCOUNTS_SHEET_NAME=AdminAccounts

# ===== Admin login (required for /admin) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-unique-password
# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Hours before the admin has to sign in again (default 8)
SESSION_HOURS=8

# ===== Certificate header (drawn in code from these values + public/logo.svg) =====
ISSUER_NAME=Northwest Samar State University
ISSUER_ADDRESS=Calbayog City, Samar, Philippines
# Words separated by commas, bullets or | (shown with gold bullets between them)
ISSUER_MOTTO=Resilience, Integrity, Service, Excellence
# Logo shown at the left of the header. File inside /public (replace public/logo.svg with your seal).
LOGO_FILE=logo.svg
# OPTIONAL banner pictures. HEADER_IMAGE replaces the coded header above; FOOTER_IMAGE is added at the bottom.
# Each one is either
#  - a file you put in the /public folder (png, jpg, webp, svg), e.g. header.png
#  - or a full https:// link to an image
# Leave empty to skip. Wide images work best (about 297 x 35 mm for the header).
HEADER_IMAGE=
FOOTER_IMAGE=

# ===== App settings (all optional) =====
# Timezone used for the issue date and the year in COA-YYYY-######
CERT_TIMEZONE=Asia/Manila
# Public URL of the deployed app. Used in event QR links and in the verify link
# printed inside each certificate's QR code.
BASE_URL=http://localhost:3000
# Optional: lets scripts call /api/certificate/list with an x-api-key header.
# Admins who are signed in at /admin can use it without a key.
ADMIN_API_KEY=change-me-to-a-long-random-string
PORT=3000

# ===== Local development only =====
# Path to a local Chrome/Chromium. Auto-detected on most machines.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
