{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{views/**,public/**,node_modules/bootstrap/dist/css/bootstrap.min.css,node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/e/:eventId", "destination": "/event.html" },
    { "source": "/p/:purposeId", "destination": "/purpose.html" },
    { "source": "/request", "destination": "/request.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
