<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Certificate of Appearance - <%= certificate.certificateNo %></title>

  <!-- Fonts: fall back to Georgia/Times if the network is unavailable -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 (inlined by the server so rendering never depends on a CDN) -->
  <% if (bootstrapCss) { %>
  <style><%- bootstrapCss %></style>
  <% } else { %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <% } %>

  <style>
    :root {
      --green-deep: #14432c;   /* text, headings */
      --green: #2e7d4f;        /* frame, accents */
      --green-soft: #8fc3a2;   /* hairlines */
      --muted: #4f6b5c;
    }

    /* ---- Print setup: A4 landscape, no browser margins ---- */
    @page { size: A4 landscape; margin: 0; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    html, body {
      width: 297mm;
      height: 210mm;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #ffffff;               /* plain white paper */
      color: var(--green-deep);
      font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    }

    .sheet {
      position: relative;
      width: 297mm;
      height: 210mm;
      padding: 6mm;
      page-break-after: avoid;
      page-break-inside: avoid;
    }

    /* ---- Green border: heavy outer line, fine inner line ---- */
    .frame {
      position: absolute;
      inset: 6mm;
      border: 1mm solid var(--green);
      pointer-events: none;
    }
    .frame::after {
      content: '';
      position: absolute;
      inset: 1.8mm;
      border: 0.25mm solid var(--green-soft);
    }

    /* ---- Corner motif: leaf sprig (same SVG, mirrored into each corner) ---- */
    .corner {
      position: absolute;
      width: 22mm;
      height: 22mm;
      pointer-events: none;
    }
    .corner.tl { top: 9mm;    left: 9mm; }
    .corner.tr { top: 9mm;    right: 9mm;  transform: scaleX(-1); }
    .corner.bl { bottom: 9mm; left: 9mm;   transform: scaleY(-1); }
    .corner.br { bottom: 9mm; right: 9mm;  transform: scale(-1, -1); }

    /* ---- Layout: header / body / footer stacked top to bottom ---- */
    .content {
      position: relative;
      height: 100%;
      padding: 6mm 14mm 5mm;
      display: flex;
      flex-direction: column;
    }

    /* ---- Header ---- */
    .header { text-align: center; }
    .header-img {
      display: block;
      width: 100%;
      max-height: 34mm;
      object-fit: contain;
      margin: 0 auto;
    }
    .logo { max-height: 20mm; max-width: 60mm; object-fit: contain; }
    .issuer-text { font-size: 17pt; font-weight: 700; letter-spacing: 0.04em; margin: 1.5mm 0 0; }
    .tagline { font-size: 11pt; color: var(--muted); font-style: italic; margin: 0; }

    /* ---- Body ---- */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 8mm;
    }
    .title {
      font-size: 34pt;
      font-weight: 600;
      letter-spacing: 0.06em;
      line-height: 1.05;
      text-align: center;
      margin: 0 0 7mm;
      color: var(--green);
    }
    .title::after {
      content: '';
      display: block;
      width: 70mm;
      height: 0.6mm;
      margin: 2.5mm auto 0;
      background: linear-gradient(90deg, transparent, var(--green), transparent);
    }
    .letter { width: 100%; max-width: 232mm; margin: 0 auto; }
    .salutation {
      font-size: 16pt;
      font-weight: 700;
      letter-spacing: 0.05em;
      margin: 0 0 4mm;
    }
    .statement {
      font-size: 19pt;
      line-height: 1.7;
      text-align: justify;
      text-indent: 14mm;
      margin: 0;
    }
    .name {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border-bottom: 0.35mm solid var(--green);
      padding: 0 1mm;
    }
    .statement strong { font-weight: 700; }

    /* ---- Footer row: issuer signature / issue date / QR + reference no ---- */
    .footer-row { align-items: flex-end; margin-top: 3mm; }
    .sign-space { height: 11mm; }
    .sign-line {
      border-top: 0.35mm solid var(--green-deep);
      margin: 0 auto;
      padding-top: 1.5mm;
      width: 66mm;
      text-align: center;
    }
    .sign-name { font-weight: 700; font-size: 12.5pt; margin: 0; }
    .sign-title { font-size: 10.5pt; color: var(--muted); margin: 0; }
    .issuer-name { font-size: 10.5pt; font-style: italic; margin: 0; }
    .issued { font-size: 12.5pt; margin: 0; text-align: center; }
    .issued small { display: block; color: var(--muted); font-size: 10pt; font-style: italic; }
    .qr { width: 24mm; height: 24mm; display: block; margin: 0 auto; }
    .ref-no { font-size: 10.5pt; letter-spacing: 0.06em; margin: 1mm 0 0; font-weight: 700; text-align: center; }
    .ref-no span { color: var(--muted); font-weight: 600; letter-spacing: 0; }

    /* ---- Footer image ---- */
    .footer-img {
      display: block;
      width: 100%;
      max-height: 22mm;
      object-fit: contain;
      margin: 3mm auto 0;
    }
  </style>
</head>
<body>
  <%
    /* Leaf sprig drawn in the top-left corner; mirrored for the other three. */
    const sprig = `
      <svg viewBox="0 0 60 60" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3 57 V3 H57" fill="none" stroke="#2e7d4f" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M9 9 C22 12 30 22 32 36" fill="none" stroke="#2e7d4f" stroke-width="1.1" stroke-linecap="round"/>
        <g fill="#2e7d4f">
          <ellipse cx="20" cy="12" rx="8" ry="3.3" transform="rotate(18 20 12)"/>
          <ellipse cx="28" cy="22" rx="8" ry="3.3" transform="rotate(52 28 22)"/>
          <ellipse cx="31" cy="34" rx="7" ry="3" transform="rotate(80 31 34)"/>
        </g>
        <g fill="#8fc3a2">
          <ellipse cx="12" cy="21" rx="7" ry="2.8" transform="rotate(72 12 21)"/>
          <ellipse cx="14" cy="32" rx="6" ry="2.5" transform="rotate(88 14 32)"/>
        </g>
        <circle cx="9" cy="9" r="2.4" fill="#14432c"/>
      </svg>`;
  %>
  <div class="sheet">
    <div class="frame"></div>
    <div class="corner tl"><%- sprig %></div>
    <div class="corner tr"><%- sprig %></div>
    <div class="corner bl"><%- sprig %></div>
    <div class="corner br"><%- sprig %></div>

    <div class="content">

      <!-- Header: banner image from HEADER_IMAGE, or logo + issuer name as a fallback -->
      <header class="header">
        <% if (headerImage) { %>
          <img class="header-img" src="<%= headerImage %>" alt="" onerror="this.style.display='none'">
        <% } else { %>
          <% if (logoImage) { %><img class="logo" src="<%= logoImage %>" alt="" onerror="this.style.display='none'"><% } %>
          <p class="issuer-text"><%= branding.issuerName %></p>
          <% if (branding.issuerTagline) { %><p class="tagline"><%= branding.issuerTagline %></p><% } %>
        <% } %>
      </header>

      <!-- Body -->
      <main class="main">
        <h1 class="title">Certificate of Appearance</h1>

        <div class="letter">
          <p class="salutation">TO WHOM IT MAY CONCERN:</p>
          <p class="statement">
            This is to certify that <span class="name"><%= certificate.fullName %></span>
            appeared and actively participated during the <strong><%= certificate.eventName %></strong>
            at <strong><%= certificate.venue %></strong>
            on <strong><%= eventDateLong %></strong>.
          </p>
        </div>
      </main>

      <!-- Footer row -->
      <footer class="row footer-row g-0">
        <div class="col-4">
          <div class="sign-space"></div>
          <div class="sign-line">
            <p class="sign-name"><%= branding.signatoryName %></p>
            <p class="sign-title"><%= branding.signatoryTitle %></p>
            <p class="issuer-name"><%= branding.issuerName %></p>
          </div>
        </div>

        <div class="col-4">
          <p class="issued"><%= issueDateLong %><small>Date issued</small></p>
        </div>

        <div class="col-4">
          <img class="qr" src="<%= qrDataUri %>" alt="Verification QR code">
          <p class="ref-no"><span>CA Reference No:</span> <%= certificate.certificateNo %></p>
        </div>
      </footer>

      <!-- Footer banner image from FOOTER_IMAGE -->
      <% if (footerImage) { %>
        <img class="footer-img" src="<%= footerImage %>" alt="" onerror="this.style.display='none'">
      <% } %>

    </div>
  </div>
</body>
</html>
